<Window x:Class="HotelManagementApp.Views.DashBoard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="800" Width="1500"
        Title="DashBoard"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"  
        WindowStyle="SingleBorderWindow">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <StackPanel Grid.Column="0" Background="#EDE6FB" VerticalAlignment="Stretch">
            <!-- Logo -->
            <Image Source="\Asset\logo.png" Width="120" Height="40" Margin="20,10,20,0"/>

            <!-- Navigation Sections -->
            <ListBox Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="12"
                                    Margin="5,2"
                                    Padding="8">
                                        <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="10,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DDD1F6"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#D6BCFA"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>

                <!-- Menu Items -->
                <ListBoxItem MouseLeftButtonUp="NavigateToDashBoard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="16" Margin="10,0,10,0"/>
                        <TextBlock Text="Dashboard" FontSize="16" Foreground="#4A5568"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem IsHitTestVisible="False">
                    <TextBlock Text="Management" FontSize="14" Foreground="#A0AEC0" Margin="15,20,0,5"/>
                </ListBoxItem>

                <ListBoxItem MouseLeftButtonUp="NavigateToGuest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="16" Margin="10,0,10,0"/>
                        <TextBlock Text="Guests" FontSize="16" Foreground="#4A5568"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- Rooms -->
                <ListBoxItem MouseLeftButtonUp="NavigateToRooms">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛏" FontSize="16" Margin="10,0,10,0"/>
                        <TextBlock Text="Rooms" FontSize="16" Foreground="#4A5568"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem IsHitTestVisible="False">
                    <TextBlock Text="Operations" FontSize="14" Foreground="#A0AEC0" Margin="15,20,0,5"/>
                </ListBoxItem>

                <!-- Invoice -->
                <ListBoxItem MouseLeftButtonUp="NavigateToInvoice">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" FontSize="16" Margin="10,0,10,0"/>
                        <TextBlock Text="Invoice" FontSize="16" Foreground="#4A5568"/>
                    </StackPanel>
                </ListBoxItem>

                <!-- Services -->
                <ListBoxItem MouseLeftButtonUp="NavigateToServices">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧹" FontSize="16" Margin="10,0,10,0"/>
                        <TextBlock Text="Services" FontSize="16" Foreground="#4A5568"/>
                    </StackPanel>
                </ListBoxItem>

                <ListBoxItem IsHitTestVisible="False">
                    <TextBlock Text="Other" FontSize="14" Foreground="#A0AEC0" Margin="15,20,0,5"/>
                </ListBoxItem>

                <!-- Report -->
                <ListBoxItem MouseLeftButtonUp="NavigateToReport">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📈" FontSize="16" Margin="10,0,10,0"/>
                        <TextBlock Text="Report" FontSize="16" Foreground="#4A5568"/>
                    </StackPanel>
                </ListBoxItem>

            </ListBox>
        </StackPanel>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <!-- Frame to load different Pages -->
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>

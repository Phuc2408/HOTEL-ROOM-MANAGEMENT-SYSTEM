<Page x:Class="HotelManagementApp.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      xmlns:local="clr-namespace:HotelManagementApp.ViewModels"
      Title="Reports"
      Background="White"
      FontFamily="Poppins"
      FontSize="14">

    <Page.DataContext>
        <local:ReportViewModel />
    </Page.DataContext>

    <Grid Margin="30" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Biểu đồ doanh thu -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Biểu đồ số lượng khách -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Report Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#673AB7"
                   Margin="0,0,0,20"
                   VerticalAlignment="Center"/>

        <!-- Cột trái: biểu đồ doanh thu -->
        <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Doanh thu + thay đổi + nút chọn -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tổng doanh thu -->
                <StackPanel Orientation="Vertical" Grid.Column="0">
                    <TextBlock Text="Revenue" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding RevenueChangeIcon}" Foreground="{Binding RevenueChangeColor}" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding RevenueChangeText}" Foreground="{Binding RevenueChangeColor}" FontSize="14"/>
                        <TextBlock Text="{Binding RevenueCompareLabel}" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nút chọn thời gian -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Top" Margin="10,40,0,0">
                    <Button Content="Today" Command="{Binding ChangeModeCommand}" CommandParameter="Today" Margin="5"/>
                    <Button Content="Week" Command="{Binding ChangeModeCommand}" CommandParameter="Week" Margin="5"/>
                    <Button Content="Month" Command="{Binding ChangeModeCommand}" CommandParameter="Month" Margin="5"/>
                    <Button Content="Year" Command="{Binding ChangeModeCommand}" CommandParameter="Year" Margin="5"/>
                </StackPanel>
            </Grid>

            <!-- Biểu đồ doanh thu -->
            <lvc:CartesianChart Grid.Row="1" Series="{Binding ChartSeries}" Height="250" Margin="0,10,0,0" LegendLocation="None">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Time" Labels="{Binding Labels}" />
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Revenue (VNĐ)" LabelFormatter="{Binding YFormatter}" />
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </Grid>

        <!-- Biểu đồ số lượng khách theo tháng -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,20,0,0">
            <TextBlock Text="Guests by Month"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <lvc:CartesianChart Series="{Binding GuestSeries}" Height="250" Margin="0,10,0,0">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Labels="{Binding GuestLabels}" Title="Month" LabelsRotation="0"/>
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Guests" MinValue="0"/>
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
        </StackPanel>

        <!-- Cột phải: chỗ placeholder cho chart khác -->
        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
            <TextBlock Text="Service Usage Distribution" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <lvc:PieChart Series="{Binding ServiceUsageSeries}" 
                          InnerRadius="30"
                          Height="250" 
                          LegendLocation="Bottom">
                <lvc:PieChart.DataTooltip>
                    <lvc:DefaultTooltip SelectionMode="OnlySender"/>
                </lvc:PieChart.DataTooltip>
            </lvc:PieChart>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,20,0,0">
            <TextBlock Text="Room Type Distribution" FontSize="16" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>
            <lvc:PieChart Series="{Binding RoomTypeSeries}"
              Height="220"
              Width="250"
              LegendLocation="Bottom"
              InnerRadius="30"
              Margin="0,0,0,10">
                <lvc:PieChart.DataTooltip>
                    <lvc:DefaultTooltip SelectionMode="OnlySender"/>
                </lvc:PieChart.DataTooltip>
            </lvc:PieChart>

        </StackPanel>

    </Grid>
</Page>

<Page x:Class="HotelManagementApp.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:HotelManagementApp.ViewModels"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"

      Title="Reports"
      Background="White"
      FontFamily="Poppins"
      FontSize="14">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Báo cáo tổng quan -->
        <TextBlock Grid.Row="0" Text="Hotel Management Reports" FontSize="24" FontWeight="Bold" Foreground="#673AB7" Margin="20,10,0,20"/>

        <!-- Lọc báo cáo theo khoảng thời gian -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ComboBox Width="150" Margin="0,0,10,0" materialDesign:HintAssist.Hint="Sort">
                <ComboBoxItem Content="Daily"/>
                <ComboBoxItem Content="Weekly"/>
                <ComboBoxItem Content="Monthly"/>
                <ComboBoxItem Content="Yearly"/>
            </ComboBox>
        </StackPanel>

        <!-- Phần báo cáo -->
        <TabControl Grid.Row="2">
            <TabItem Header="Doanh thu">
                <StackPanel>
                    <TextBlock Text="Tổng doanh thu theo ngày/tuần/tháng/năm" FontSize="18" Margin="10"/>
                    <TextBlock Text="{Binding TotalRevenue}" FontSize="16" Margin="10"/>
                    <!-- Có thể thêm Biểu đồ doanh thu ở đây -->
                </StackPanel>
            </TabItem>

            <TabItem Header="Tỷ lệ phòng đã đặt">
                <StackPanel>
                    <TextBlock Text="Tỷ lệ phòng đã đặt" FontSize="18" Margin="10"/>
                    <TextBlock Text="{Binding OccupancyRate}" FontSize="16" Margin="10"/>
                    <!-- Biểu đồ tỷ lệ phòng đã đặt -->
                </StackPanel>
            </TabItem>

            <TabItem Header="Phân tích khách hàng">
                <StackPanel>
                    <TextBlock Text="Phân tích khách hàng (Quốc tịch, Loại khách, Thời gian lưu trú)" FontSize="18" Margin="10"/>
                    <TextBlock Text="{Binding CustomerAnalysis}" FontSize="16" Margin="10"/>
                    <!-- Biểu đồ phân tích khách hàng -->
                </StackPanel>
            </TabItem>

            <TabItem Header="Phân tích dịch vụ">
                <StackPanel>
                    <TextBlock Text="Phân tích dịch vụ (Sử dụng dịch vụ phụ)" FontSize="18" Margin="10"/>
                    <TextBlock Text="{Binding ServiceUsageAnalysis}" FontSize="16" Margin="10"/>
                    <!-- Biểu đồ phân tích dịch vụ -->
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Page>

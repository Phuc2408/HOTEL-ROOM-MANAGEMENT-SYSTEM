<Page x:Class="HotelManagementApp.Views.DashBoard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:HotelManagementApp.ViewModels"
      Title="Dashboard"
      Background="White">

    <Page.DataContext>
        <local:DashBoardViewModel />
    </Page.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Dashboard Title -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dashboard" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,10"/>

        <!-- Cards -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10">
            <!-- Available Card -->
            <Border Width="150" Height="100" Background="White" CornerRadius="12" Margin="8" Padding="10"
                    Effect="{DynamicResource MaterialDesignShadowDepth2}" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="MediumSeaGreen" RadiusX="4" RadiusY="4" Width="5" Margin="0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Available" FontWeight="Bold" FontSize="14" Foreground="#222"/>
                        <TextBlock Text="{Binding AvailableRooms}" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="40" Height="40" Background="#32CD32" CornerRadius="20" Margin="10" VerticalAlignment="Center">
                        <Viewbox>
                            <materialDesign:PackIcon Kind="Login" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <!-- Check-in Card -->
            <Border Width="150" Height="100" Background="White" CornerRadius="12" Margin="8" Padding="10"
                    Effect="{DynamicResource MaterialDesignShadowDepth2}" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="DarkOrange" RadiusX="4" RadiusY="4" Width="5" Margin="0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Check-in" FontWeight="Bold" FontSize="14" Foreground="#222"/>
                        <TextBlock Text="{Binding CheckIn}" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="40" Height="40" Background="#FFA500" CornerRadius="20" Margin="10" VerticalAlignment="Center">
                        <Viewbox>
                            <materialDesign:PackIcon Kind="Login" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <!-- Check-out Card -->
            <Border Width="150" Height="100" Background="White" CornerRadius="12" Margin="8" Padding="10"
                    Effect="{DynamicResource MaterialDesignShadowDepth2}" BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Fill="DarkOrange" RadiusX="4" RadiusY="4" Width="5" Margin="0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="Check-out" FontWeight="Bold" FontSize="14" Foreground="#222"/>
                        <TextBlock Text="{Binding CheckOut}" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="40" Height="40" Background="#FFA500" CornerRadius="20" Margin="10" VerticalAlignment="Center">
                        <Viewbox>
                            <materialDesign:PackIcon Kind="Logout" Foreground="White"/>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Status Table -->
        <Border Grid.Row="2" Grid.Column="0" CornerRadius="10" Background="White" Padding="20" Margin="0,10,10,0" Effect="{DynamicResource MaterialDesignShadowDepth2}">
            <StackPanel>
                <TextBlock Text="Status" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Room Statuses -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Available" Width="100"/>
                    <TextBlock Text="{Binding AvailableRoomsStatus}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Untidy" Width="100"/>
                    <TextBlock Text="{Binding UntidyRoomsStatus}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Repair" Width="100"/>
                    <TextBlock Text="{Binding RepairRoomsStatus}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="In use" Width="100"/>
                    <TextBlock Text="{Binding InUseRoomsStatus}" FontWeight="Bold"/>
                </StackPanel>

                <Separator Margin="0,10"/>

                <!-- Room Types -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Single" Width="100"/>
                    <TextBlock Text="{Binding SingleRoomsCount}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Twin" Width="100"/>
                    <TextBlock Text="{Binding TwinRoomsCount}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Double" Width="100"/>
                    <TextBlock Text="{Binding DoubleRoomsCount}" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="VIP" Width="100"/>
                    <TextBlock Text="{Binding VIPRoomsCount}" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Clock and Calendar -->
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
            <Ellipse Width="80" Height="80" Stroke="Black" StrokeThickness="2" HorizontalAlignment="Center" Margin="0,10"/>
            <Calendar Margin="0,10" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
        </StackPanel>
    </Grid>
</Page>

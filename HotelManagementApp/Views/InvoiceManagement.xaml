<Page x:Class="HotelManagementApp.Views.InvoiceManagement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
      xmlns:local="clr-namespace:HotelManagementApp.ViewModels"
      mc:Ignorable="d" 
      Background="white"
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="InvoiceManagement">
    <Page.DataContext>
        <!-- Binding với ViewModel -->
        <local:InvoiceManagementViewModel />
    </Page.DataContext>

    <Grid Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <!-- Title -->
        <TextBlock Grid.Row="1"
                    Text="Invoice Management"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#673AB7"
                    Margin="20,10,0,20"
                    VerticalAlignment="Center"/>    
        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <!-- 🔍 Search -->
                <TextBox Width="200" Margin="0,0,10,0"
         materialDesign:HintAssist.Hint="Search..."
         VerticalAlignment="Center"
         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 🔽 Sort -->
                <ComboBox Width="150" Margin="0,0,10,0"
          VerticalAlignment="Center"
          materialDesign:HintAssist.Hint="Sort">
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Oldest"/>
                </ComboBox>


            </StackPanel>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="InvoiceDataGrid"
      Grid.Row="3"
      AutoGenerateColumns="False"
                  VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Auto"
      IsReadOnly="True"
      CanUserAddRows="False"
      SelectionMode="Single"
      Margin="10,0,0,10"
      RowHeight="36"
      GridLinesVisibility="Horizontal"
      VerticalAlignment="Top"
      Background="White"
      BorderThickness="0"
      ItemsSource="{Binding Invoices}" SelectionChanged="InvoiceDataGrid_SelectionChanged">

            <DataGrid.Columns >
                <!-- InvoiceID -->
                <DataGridTextColumn Header="Invoice ID" Binding="{Binding InvoiceID}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Rent ID -->
                <DataGridTextColumn Header="Rent ID" Binding="{Binding RentID}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Guest Name -->
                <DataGridTextColumn Header="Guest Name" Binding="{Binding GuestName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Invoice Date -->
                <DataGridTextColumn Header="Invoice Date" Binding="{Binding CheckOutDate}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Invoice Detail -->
                <DataGridTemplateColumn Header="Invoice Detail" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="LightGray" CornerRadius="5" Padding="4" HorizontalAlignment="Left">
                                <Button Content="Detail"
        Style="{StaticResource IconButtonStyle}"
        Click="DetailButton_Click"
        Margin="5"
        FontSize="13"
        FontWeight="Normal"
        VerticalAlignment="Center"
        HorizontalAlignment="Left"
        DataContext="{Binding}" />
                                <!-- 🟢 Dòng này là quan trọng nhất -->

                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>
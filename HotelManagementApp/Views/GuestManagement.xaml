<Page x:Class="HotelManagementApp.Views.GuestManagement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:local="clr-namespace:HotelManagementApp.ViewModels"
      Title="Guest Management"
      Background="White"
      FontFamily="Poppins"
      FontSize="14">

    <Page.DataContext>
        <local:GuestManagementViewModel />
    </Page.DataContext>

    <Grid Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="1"
                   Text="Guest Management"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#673AB7"
                   Margin="20,10,0,20"
                   VerticalAlignment="Center"/>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <!-- 🔍 Search -->
                <TextBox Width="200" Margin="0,0,10,0"
                         materialDesign:HintAssist.Hint="Search..."
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 🔽 Sort -->
                <ComboBox Width="150" Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          materialDesign:HintAssist.Hint="Sort">
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Oldest"/>
                </ComboBox>

                <!-- Buttons -->
                <Button x:Name="EditButton" 
                        Style="{StaticResource SquareIconButtonStyle}" 
                        Background="Transparent" 
                        Foreground="#673AB7" 
                        Margin="0,0,5,0" 
                        Padding="8,3" 
                        BorderThickness="0" 
                        Click="EditButton_Click">
                    <iconPacks:PackIconMaterial Kind="SquareEditOutline" Width="15" Height="15"/>
                </Button>
                <Button x:Name="DeleteButton" 
                        Style="{StaticResource SquareIconButtonStyle}" 
                        Background="Transparent" 
                        Foreground="red" 
                        Margin="0,0,5,0" 
                        Padding="8,3" 
                        BorderThickness="0" 
                        Command="{Binding DeleteCommand}">
                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="15" Height="15"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="GuestDataGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Guests}"
                  SelectedItem="{Binding SelectedGuest, Mode=TwoWay}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Margin="10,0,0,10"
                  RowHeight="36"
                  GridLinesVisibility="Horizontal"
                  VerticalAlignment="Top"
                  Background="White"
                  BorderThickness="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Guest Name" Binding="{Binding GuestName}" Width="*"/>
                <DataGridTextColumn Header="ID Card" Binding="{Binding IdCard}" Width="*"/>
                <DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneNumber}" Width="*"/>
                <DataGridTextColumn Header="Check In Date" Binding="{Binding CheckInDate, StringFormat='dd/MM/yyyy'}" Width="*"/>

                <DataGridTemplateColumn Header="Room" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding StatusColor}" CornerRadius="5" Padding="4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Room}" FontSize="13" Foreground="White"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>

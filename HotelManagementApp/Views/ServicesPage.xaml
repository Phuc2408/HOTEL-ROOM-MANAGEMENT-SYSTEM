<Page x:Class="HotelManagementApp.Views.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" 
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
xmlns:Icon="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.Material" 
xmlns:local="clr-namespace:HotelManagementApp.ViewModels"
Title="Service Management"
Background="White"
FontFamily="Poppins"
FontSize="14">

 

    <Grid Margin="20,0,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <!-- Title -->
        <TextBlock Grid.Row="1"
                    Text="Service Management"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="#673AB7"
                    Margin="20,10,0,20"
                    VerticalAlignment="Center"/>                

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <!-- 🔍 Search -->
                <TextBox Width="200" Margin="0,0,10,0"
         materialDesign:HintAssist.Hint="Search..."
         VerticalAlignment="Center"/>

                <!-- 🔽 Sort -->
                <ComboBox Width="150" Margin="0,0,10,0"
          VerticalAlignment="Center"
          materialDesign:HintAssist.Hint="Sort">
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Oldest"/>
                </ComboBox>


                <!-- Buttons -->
                <Button x:Name="EditButton" 
        Style="{StaticResource SquareIconButtonStyle}" 
        Background="Transparent" 
        Foreground="#673AB7" 
        Margin="0,0,5,0" 
        Padding="8,3" 
        BorderThickness="0" 
        Command="{Binding EditCommand}">
                    <!-- ✅ Dùng MVVM -->
                    <iconPacks:PackIconMaterial Kind="SquareEditOutline" Width="15" Height="15"/>
                </Button>

                <Button x:Name="DeleteButton" 
                        Style="{StaticResource SquareIconButtonStyle}" 
                        Background="Transparent" 
                        Foreground="red" 
                        Margin="0,0,5,0" 
                        Padding="8,3" 
                        BorderThickness="0" 
                        Command="{Binding DeleteCommand}">
                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="15" Height="15"/>
                </Button>
                <Button x:Name="InsertButton" 
                        Style="{StaticResource SquareIconButtonStyle}" 
                        Background="Transparent"
                        Foreground="#2196F3" 
                        Padding="8,3" 
                        BorderThickness="0" 
                        Click="InsertButton_Click">
                    <iconPacks:PackIconMaterial Kind="PlusBoxOutline" Width="15" Height="15"/>
                </Button>


            </StackPanel>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="ServiceDataGrid"
      Grid.Row="3"
      AutoGenerateColumns="False"
              VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Auto"
      IsReadOnly="True"
      CanUserAddRows="False"
      SelectionMode="Single"
      Margin="10,0,0,10"
      RowHeight="36"
      GridLinesVisibility="Horizontal"
      VerticalAlignment="Top"
      Background="White"
      BorderThickness="0"
      ItemsSource="{Binding Services}"
      SelectedItem="{Binding SelectedService, Mode=TwoWay}">

            <DataGrid.Columns>
               
                <!-- IDservice -->
                <DataGridTextColumn Header="Service ID" Binding="{Binding SID}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- service Name -->
                <DataGridTextColumn Header="Service Name" Binding="{Binding SName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- unit -->
                <DataGridTextColumn Header="Unit" Binding="{Binding SUnit}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- unit price -->
                <DataGridTextColumn Header="Unit Price" Binding="{Binding SPrice}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Page>

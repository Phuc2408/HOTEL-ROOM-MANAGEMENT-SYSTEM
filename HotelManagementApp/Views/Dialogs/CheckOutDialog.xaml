<Window x:Class="HotelManagementApp.Views.Dialogs.CheckOutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:HotelManagementApp.ViewModels"
        Title="Check Out" Height="600" Width="700"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:CheckOutDialogViewModel />
    </Window.DataContext>

    <Border Background="Transparent" CornerRadius="12" Padding="20">
        <Grid>
            <TabControl materialDesign:ColorZoneAssist.Mode="SecondaryDark">

                <!-- Tab Check-out -->
                <TabItem Header="Check-out">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Invoice Detail"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20" />

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0" Margin="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Guest name"
                                     IsReadOnly="True"
                                     Text="{Binding GuestName}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="ID Card"
                                     IsReadOnly="True"
                                     Text="{Binding IdCard}" />
                            <TextBox Grid.Row="1" Grid.Column="0" Margin="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Phone number"
                                     IsReadOnly="True"
                                     Text="{Binding PhoneNumber}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Country"
                                     IsReadOnly="True"
                                     Text="{Binding SelectedCountry}" />
                            <TextBox Grid.Row="2" Grid.Column="0" Margin="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Room"
                                     IsReadOnly="True"
                                     Text="{Binding RoomId}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="5"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Number of people"
                                     IsReadOnly="True"
                                     Text="{Binding PeopleCount}" />
                            <DatePicker Grid.Row="3" Grid.Column="0" Margin="5"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:HintAssist.Hint="Check In"
                                        IsEnabled="False"
                                        SelectedDate="{Binding CheckInDate}" />
                            <DatePicker Grid.Row="3" Grid.Column="1" Margin="5"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        materialDesign:HintAssist.Hint="Check Out"
                                        IsEnabled="False"
                                        SelectedDate="{Binding CheckOutDate}" />
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding FilteredServices}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  Margin="0,10,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice}" Width="*" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Quantity" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     HorizontalContentAlignment="Left"
                                                     TextAlignment="Left"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Price" Binding="{Binding TotalAmount}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2"
                                   Text="{Binding TotalPrice, StringFormat=Total: {0:N0} VND}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#2E86C1"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Bottom" />

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Confirm" Margin="5" Width="100"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="ConfirmButton_Click" />
                            <Button Content="Cancel" Margin="5" Width="100"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="CancelButton_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Tab Service -->
                <TabItem Header="Service">
                    <DataGrid ItemsSource="{Binding Services}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Margin="5"
                              SelectionUnit="Cell">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="*" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice}" Width="*" />
                            <DataGridTemplateColumn Header="Quantity" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Left"
                                                 TextAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Price" Binding="{Binding TotalAmount}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>

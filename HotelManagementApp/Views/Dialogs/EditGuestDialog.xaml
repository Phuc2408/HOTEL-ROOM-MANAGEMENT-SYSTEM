<Window x:Class="HotelManagementApp.Views.Dialogs.EditGuestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:HotelManagementApp.ViewModels"
        Title="Edit Guest"
        Height="320"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">



    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Margin="0,0,0,10"
                 Text="{Binding CName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Full Name"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

        <TextBox Grid.Row="1" Margin="0,0,0,10"
                 Text="{Binding CPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Phone"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

        <TextBox Grid.Row="2" Margin="0,0,0,10"
                 Text="{Binding CPersonalID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="Personal ID"
                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

        <Button Grid.Row="3" Content="Save" HorizontalAlignment="Right"
                Margin="0,10,0,0" Width="80"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="SaveButton_Click" />
    </Grid>
</Window>
